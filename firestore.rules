rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isLegacySharedCollection(collection) {
      return collection != 'purchaseClaims'
        && collection != 'internalApiUsage'
        && collection != 'users'
        && collection != 'bible'
        && collection != 'global'
        && collection != 'reviews';
    }

    // Privileged billing and quota records are writable only through Admin SDK.
    match /purchaseClaims/{document=**} {
      allow read, write: if false;
    }

    match /internalApiUsage/{document=**} {
      allow read, write: if false;
    }

    // Profiles are visible to authenticated social features. A user can only
    // change their own profile and nested learning data.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if owns(userId);

      match /{document=**} {
        allow read: if signedIn();
        allow write: if owns(userId);
      }
    }

    // Bible content and server-managed global records are read-only clients.
    match /bible/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /global/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Review documents are private to the userId stored on the document.
    // Both sides of an update are checked so ownership cannot be transferred.
    match /reviews/{reviewId} {
      allow read: if owns(resource.data.userId);
      allow create: if owns(request.resource.data.userId);
      allow update: if owns(resource.data.userId)
        && owns(request.resource.data.userId);
      allow delete: if owns(resource.data.userId);
    }

    // Shared learning and social collections remain available to signed-in
    // users. Explicitly protected collections are excluded because Firestore
    // grants a request when any overlapping match allows it.
    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && isLegacySharedCollection(collection);
    }
  }
}
