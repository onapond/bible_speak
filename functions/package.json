{
  "name": "functions",
  "description": "Bible Speak Cloud Functions",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "jest",
    "test:rules": "firebase emulators:exec --project demo-bible-speak-rules --only firestore \"node --test firestore_rules.emulator.mjs\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^11.0.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.18.0",
    "jest": "^29.7.0"
  },
  "private": true
}
